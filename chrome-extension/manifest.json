{
  "manifest_version": 3,
  "name": "中国农业大学选课余量监控助手",
  "short_name": "农大选课助手",
  "version": "1.4.0",
  "minimum_chrome_version": "102",
  "description": "支持单课程或最多四门课程轮询，发现余量后调用教务系统原生流程选课。",
  "homepage_url": "https://github.com/apshiap05/CAU-",
  "permissions": [
    "notifications",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://newjw.cau.edu.cn/jsxsd/xsxk",
    "https://newjw.cau.edu.cn/jsxsd/xsxk/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "中国农业大学选课余量监控助手",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://newjw.cau.edu.cn/jsxsd/xsxk",
        "https://newjw.cau.edu.cn/jsxsd/xsxk/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
